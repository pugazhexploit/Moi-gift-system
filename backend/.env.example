ENVIRONMENT=development
LOG_LEVEL=INFO
MONGODB_URI=mongodb://mongodb:27017/?replicaSet=rs0
MONGODB_DATABASE=giftledger
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_SERVER_API_VERSION=1
MONGODB_SERVER_API_STRICT=true
MONGODB_SERVER_API_DEPRECATION_ERRORS=true
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FORCE_HTTPS=false
GENERAL_RATE_LIMIT_REQUESTS=300
GENERAL_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Redis is optional in Phase 2. Add it only for multi-instance rate limiting.
# REDIS_URL=redis://redis:6379/0

# Generate distinct 32+ byte values for every environment; never use these sample values in production.
JWT_SECRET=replace-with-a-strong-development-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-strong-development-secret-32-chars
JWT_ISSUER=giftledger-api
JWT_AUDIENCE=giftledger-browser
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ACCESS_COOKIE_NAME=giftledger_access
REFRESH_COOKIE_NAME=giftledger_refresh
CSRF_COOKIE_NAME=giftledger_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
